# Minimal arm controller (replaces jonny5-ws-teleop + the SPI bridge for teleoperation).
# Install: sudo cp j5mini.service /etc/systemd/system/ && sudo systemctl daemon-reload
# Stop the old stack first (jonny5-ws-teleop, jonny5-spi-j5vr / jonny5-spi-shm-bridge, jonny5-ros2):
# only one process may own the SPI and the UART.
[Unit]
Description=JONNY5 j5mini arm controller (SPI + UART + wss 8557)
After=network-online.target
Conflicts=jonny5-ws-teleop.service jonny5-spi-j5vr.service jonny5-spi-shm-bridge.service jonny5-ros2.service

[Service]
User=jonny5
WorkingDirectory=/home/jonny5/j5mini
ExecStart=/home/jonny5/raspberry5/.venv/bin/python3 /home/jonny5/j5mini/j5mini.py --config /home/jonny5/j5mini/j5mini.json
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
