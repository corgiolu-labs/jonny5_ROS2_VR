{
  "_schema": "controller_mappings_v1",
  "version": 1,
  "_doc": "Map (mode, event) -> action. Mode keys: STEREO, POSE, MANUAL, HEAD, HYBRID, ASSIST. Event format: '<hand>.<button>.<edge>[|<modifier>]'. Hands: left, right. Buttons: A, B, X, Y, trigger, grip, thumb. Edges: press (rising edge), release (falling edge), held (every frame while pressed), click (alias for press on thumb). Modifiers: bothGrips, noGrips, leftGrip, rightGrip. Action names: the ones the Quest app handles (XrActivity.runAction and the native toggles). STEREO is the app's PREPARAZIONE (mode 0, also the viewer-only session).",
  "modes": {
    "STEREO": {
      "right.A.press": "setAutofocusBoth",
      "right.thumb.click": "setAutofocusBoth",
      "left.Y.press": "toggleCrosshair",
      "left.X.press|noGrips": "togglePassthrough"
    },
    "POSE": {},
    "MANUAL": {
      "left.X.press|noGrips": "togglePassthrough",
      "left.Y.press": "toggleCrosshair",
      "right.thumb.click": "refocusCamerasHw"
    },
    "HEAD": {
      "left.X.press|noGrips": "togglePassthrough",
      "left.Y.press": "toggleCrosshair",
      "right.thumb.click": "refocusCamerasHw",
      "right.A.held|bothGrips": "zoom_in_continuous",
      "right.B.held|bothGrips": "zoom_out_continuous"
    },
    "HYBRID": {
      "left.X.press|noGrips": "togglePassthrough",
      "left.Y.press": "toggleCrosshair",
      "right.thumb.click": "refocusCamerasHw",
      "right.A.held|bothGrips": "zoom_in_continuous",
      "right.B.held|bothGrips": "zoom_out_continuous"
    },
    "ASSIST": {
      "left.X.press|noGrips": "togglePassthrough",
      "left.Y.press": "toggleCrosshair",
      "right.thumb.click": "refocusCamerasHw",
      "right.A.held|bothGrips": "zoom_in_continuous",
      "right.B.held|bothGrips": "zoom_out_continuous"
    }
  }
}
