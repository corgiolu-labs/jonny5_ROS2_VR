# JONNY5 - automatic crosshair collimation for the VR viewers (raspberry/tools/stereo_collimator.py).
# Decodes only the keyframes of cam0/cam1 from the local MediaMTX (~10 % of one core), finds where the centre of
# cam0 is in cam1 and broadcasts {"type":"stereo_collimation",...} through ws-teleop. Installed by
# ros2_ws/deploy/setup_hotspot.sh.
[Unit]
Description=JONNY5 stereo crosshair collimation (cam0/cam1 disparity at the crosshair)
After=jonny5-video-capture.service jonny5-ws-teleop.service
Wants=jonny5-video-capture.service

[Service]
Type=simple
WorkingDirectory=/home/jonny5ros2/JONNY5_ROS2
ExecStart=/usr/bin/python3 -u /home/jonny5ros2/JONNY5_ROS2/raspberry/tools/stereo_collimator.py
User=jonny5ros2
Nice=10
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
