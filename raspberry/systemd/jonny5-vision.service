# JONNY5 - on-demand object recognition, stereo distance and OCR for the Quest XR app
# (raspberry/tools/vision_service.py). Decodes only the keyframes of cam0/cam1 from the local MediaMTX and waits for
# {"type":"vision_request"} through ws-teleop; YOLO11n + RapidOCR run only on request, at low priority.
# Python: raspberry/.venv-vision (system site packages for PyAV / numpy, onnxruntime + rapidocr + opencv inside).
[Unit]
Description=JONNY5 vision (objects, distance, text on request)
After=jonny5-video-capture.service jonny5-ws-teleop.service
Wants=jonny5-video-capture.service

[Service]
Type=simple
WorkingDirectory=/home/jonny5ros2/JONNY5_ROS2
ExecStart=/home/jonny5ros2/JONNY5_ROS2/raspberry/.venv-vision/bin/python -u /home/jonny5ros2/JONNY5_ROS2/raspberry/tools/vision_service.py --threads 1
User=jonny5ros2
Nice=19
# only spare CPU: the camera encoders must never wait for an analysis
CPUSchedulingPolicy=idle
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
