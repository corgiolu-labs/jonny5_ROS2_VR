# The two cameras (raspberry/tools/cam_stream.py, frame sync + matched exposure) publishing cam0/cam1 to the
# local MediaMTX (profile "relay"). Installed by raspberry/setup_pi.sh.
[Unit]
Description=JONNY5 camera capture -> MediaMTX relay (sync + matched exposure)
After=jonny5-mediamtx.service jonny5-sync-route.service
Requires=jonny5-mediamtx.service jonny5-sync-route.service
PartOf=jonny5-mediamtx.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
ExecStart=/bin/bash @REPO@/scripts/video_capture.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
