# MediaMTX (profile in raspberry/config_runtime/video/video_pipeline.yaml: relay). Installed by raspberry/setup_pi.sh.
[Unit]
Description=JONNY5 MediaMTX (RTSP for the Quest app)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
ExecStart=/bin/bash @REPO@/scripts/start_mediamtx.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
