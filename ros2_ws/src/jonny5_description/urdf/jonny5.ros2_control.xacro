<?xml version="1.0"?>
<!-- ros2_control description of JONNY5: jonny5_control/Jonny5System streams joint
     positions to the STM32 over SPI protocol v2 (docs/ROS2_CONTROL.md). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="jonny5_joint_interfaces" params="name lower upper">
    <joint name="${name}">
      <command_interface name="position">
        <param name="min">${lower}</param>
        <param name="max">${upper}</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </xacro:macro>

  <xacro:macro name="jonny5_ros2_control"
               params="mock_hardware:=true spi_device:=/dev/spidev0.0 spi_speed_hz:=1000000
                       transfer_len:=128 servo_offsets_deg:=100,88,93,95,90,95
                       servo_dirs:=1,-1,-1,1,-1,1">
    <ros2_control name="JONNY5" type="system">
      <hardware>
        <plugin>jonny5_control/Jonny5System</plugin>
        <param name="mock_hardware">${mock_hardware}</param>
        <param name="spi_device">${spi_device}</param>
        <param name="spi_speed_hz">${spi_speed_hz}</param>
        <!-- 128 = firmware CONFIG_J5_CANONICAL_PADDED_128_MODE (default build) -->
        <param name="transfer_len">${transfer_len}</param>
        <!-- Must match raspberry/config_runtime/robot/j5_settings.json offsets/dirs -->
        <param name="servo_offsets_deg">${servo_offsets_deg}</param>
        <param name="servo_dirs">${servo_dirs}</param>
        <param name="link_timeout_ms">500</param>
      </hardware>
      <!-- Command limits = URDF joint limits (the firmware clamps again). -->
      <xacro:jonny5_joint_interfaces name="base_joint" lower="-0.785398" upper="0.785398" />
      <xacro:jonny5_joint_interfaces name="shoulder_joint" lower="-1.047198" upper="0.959931" />
      <xacro:jonny5_joint_interfaces name="elbow_joint" lower="-1.047198" upper="0.959931" />
      <xacro:jonny5_joint_interfaces name="wrist_yaw_joint" lower="-0.785398" upper="0.785398" />
      <xacro:jonny5_joint_interfaces name="wrist_pitch_joint" lower="-0.959931" upper="0.523599" />
      <xacro:jonny5_joint_interfaces name="wrist_roll_joint" lower="-0.785398" upper="0.785398" />
      <sensor name="imu_sensor">
        <state_interface name="orientation.x" />
        <state_interface name="orientation.y" />
        <state_interface name="orientation.z" />
        <state_interface name="orientation.w" />
        <state_interface name="angular_velocity.x" />
        <state_interface name="angular_velocity.y" />
        <state_interface name="angular_velocity.z" />
        <state_interface name="linear_acceleration.x" />
        <state_interface name="linear_acceleration.y" />
        <state_interface name="linear_acceleration.z" />
        <param name="frame_id">imu_link</param>
      </sensor>
      <gpio name="jonny5_status">
        <state_interface name="fsm_state" />
        <state_interface name="estop_active" />
        <state_interface name="movement_allowed" />
        <state_interface name="joint_stream_live" />
        <state_interface name="link_ok" />
        <state_interface name="rt_loop_period_us" />
        <state_interface name="rt_overruns" />
        <state_interface name="rx_seq_gaps" />
        <state_interface name="crc_errors_stm" />
        <state_interface name="crc_errors_pi" />
      </gpio>
    </ros2_control>
  </xacro:macro>
</robot>
